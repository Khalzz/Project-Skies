EventSystem (
    /*
    event_list: {
        1000: Event (
            event_type: PlayAudio(
                AudioFile(
                    file_name: "./assets/audio/ReasonToFight"
                )
            ),
        )
    },
    */

    // Locks out player input (flight controls and the pause menu itself -
    // see EventSystem::input_lock_end's own doc comment) while the mission
    // intro's black screen and title are up. Only a "hold ESC to skip" still
    // works during this window. Anything in the world (aircraft, cameras,
    // paths) is animated by the level's own animations - map.ron's
    // `sequences`, edited in F10's timeline.
    input_locks: [
        (start_time: 0, end_time: 4400),
    ],
    ui_tracks: [
        Alpha(
            target: "mission_intro/title",
            keyframes: [
                (time: 0,    value: 0.0),
                (time: 800,  value: 0.0),
                (time: 1600, value: 1.0),
                (time: 3600, value: 1.0),
                (time: 4400, value: 0.0),
            ],
        ),
        Alpha(
            target: "mission_intro/location",
            keyframes: [
                (time: 0,    value: 0.0),
                (time: 800,  value: 0.0),
                (time: 1600, value: 1.0),
                (time: 3600, value: 1.0),
                (time: 4400, value: 0.0),
            ],
        ),
        Alpha(
            target: "mission_intro/date",
            keyframes: [
                (time: 0,    value: 0.0),
                (time: 800,  value: 0.0),
                (time: 1600, value: 1.0),
                (time: 3600, value: 1.0),
                (time: 4400, value: 0.0),
            ],
        ),
        Color(
            target: "mission_intro_backdrop",
            keyframes: [
                (time: 0,    value: (r: 0, g: 0, b: 0, a: 255)),
                (time: 3600, value: (r: 0, g: 0, b: 0, a: 255)),
                (time: 4400, value: (r: 0, g: 0, b: 0, a: 0)),
            ],
        ),
        Active(target: "mission_intro", start_time: 4400, keyframes: [ (time: 0, value: false) ]),
        Active(target: "mission_intro_backdrop", start_time: 4400, keyframes: [ (time: 0, value: false) ]),

        Active(target: "game_ui", start_time: 4400, keyframes: [ (time: 0, value: true) ]),
        Active(target: "velocity_marker", start_time: 4400, keyframes: [ (time: 0, value: true) ]),

        Alpha(target: "game_ui/data_box/timer", start_time: 4400, keyframes: [ (time: 0, value: 0.0), (time: 600, value: 1.0) ]),
        Alpha(target: "game_ui/data_box/framerate", start_time: 4400, keyframes: [ (time: 0, value: 0.0), (time: 600, value: 1.0) ]),
        Alpha(target: "game_ui/data_box/g", start_time: 4400, keyframes: [ (time: 0, value: 0.0), (time: 600, value: 1.0) ]),
        Alpha(target: "game_ui/data_box/power", start_time: 4400, keyframes: [ (time: 0, value: 0.0), (time: 600, value: 1.0) ]),
        Alpha(target: "game_ui/compass", start_time: 4400, keyframes: [ (time: 0, value: 0.0), (time: 600, value: 1.0) ]),
        Alpha(target: "game_ui/speed", start_time: 4400, keyframes: [ (time: 0, value: 0.0), (time: 600, value: 1.0) ]),
        Alpha(target: "velocity_marker", start_time: 4400, keyframes: [ (time: 0, value: 0.0), (time: 600, value: 1.0) ]),

        Color(
            target: "game_ui/data_box",
            start_time: 4400,
            keyframes: [
                (time: 0,   value: (r: 0, g: 0, b: 0, a: 0)),
                (time: 600, value: (r: 0, g: 0, b: 0, a: 128)),
            ],
        ),
    ],
)
