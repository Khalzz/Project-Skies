// Which actions (see settings/input.ron for their actual bindings) get a row in
// the Controller settings tab, grouped by what they do - see
// main_menu::ui::controller_settings_list, the only reader. Deliberately a
// curated subset, not every action in input.ron: debug/camera-debug/UI-internal
// actions (toggle_debug, debug_cam_*, ui_click, ...) aren't meant to be
// player-rebindable, so they're left out rather than showing up here too.
[
    (name: "Flying", actions: [
        "pitch_up",
        "pitch_down",
        "roll_left",
        "roll_right",
        "rudder_left",
        "rudder_right",
        "throttle_up",
        "throttle_down",
        "throttle_axis",
        "trim_pitch_up",
        "trim_pitch_down",
        "trim_roll_left",
        "trim_roll_right",
        "trim_yaw_left",
        "trim_yaw_right",
    ]),
    (name: "Camera", actions: [
        "change_camera",
        "look_left",
        "look_right",
        "look_up",
        "look_down",
        "fix_view",
    ]),
    (name: "Gear", actions: [
        "up_wheel",
        "down_wheel",
        "toggle_landing_gear",
        "landing_gear_up",
        "landing_gear_down",
        "toggle_air_brake",
        "air_brake_extend",
        "air_brake_retract",
        "wheel_brake",
        "toggle_parking_brake",
    ]),
    (name: "Weapons", actions: [
        "next_weapon",
        "fire_weapon",
        "toggle_lock",
        "countermeasure_single",
        "countermeasure_program",
        "countermeasure_mode",
    ]),
    (name: "Menus", actions: [
        "quick_menu_up",
        "quick_menu_right",
        "quick_menu_down",
        "quick_menu_left",
    ]),
]
