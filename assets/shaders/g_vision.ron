// g_vision.wgsl's settings - the play scene's Fullscreen step (see
// game::screen_effects, which sets its params every frame).
(
    kind: Fullscreen,
    inputs: ["scene", "hud"],   // the world drawn so far, and the "hud" target
    blend: None,                // it covers the whole screen
    params: {
        // The HUD as drawn, nothing else - until the play scene says.
        "hud_params": (1.0, 0.0, 0.0, 0.0),
    },
)
