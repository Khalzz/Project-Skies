(
    actions: [
        (action: "pitch_up", bindings: [Key("w"), ControllerAxis(axis: "LeftY", positive: false)]),
        (action: "roll_left", bindings: [Key("a"), ControllerAxis(axis: "LeftX", positive: false)]),
        (action: "pitch_down", bindings: [Key("s"), ControllerAxis(axis: "LeftY", positive: true)]),
        (action: "roll_right", bindings: [Key("d"), ControllerAxis(axis: "LeftX", positive: true)]),
        (action: "rudder_left", bindings: [Key("q"), ControllerButton("LeftShoulder")]),
        (action: "rudder_right", bindings: [Key("e"), ControllerButton("RightShoulder")]),
        (action: "throttle_up", bindings: [Key("Up"), ControllerAxis(axis: "TriggerRight", positive: true)]),
        (action: "throttle_down", bindings: [Key("Down"), ControllerAxis(axis: "TriggerLeft", positive: true)]),
        // A throttle lever (a HOTAS throttle's axis) - read as a position, not
        // pressed/not: where the lever is is the throttle (see Plane).
        (action: "throttle_axis", bindings: []),
        (action: "change_camera", bindings: [Key("v"), ControllerButton("Y")]),
        // Right-stick camera look - deadzone must match LOOK_STICK_DEADZONE
        // in play::camera::camera.
        (action: "look_left", bindings: [ControllerAxis(axis: "RightX", positive: false, deadzone: 0.1)]),
        (action: "look_right", bindings: [ControllerAxis(axis: "RightX", positive: true, deadzone: 0.1)]),
        (action: "look_up", bindings: [ControllerAxis(axis: "RightY", positive: false, deadzone: 0.1)]),
        (action: "look_down", bindings: [ControllerAxis(axis: "RightY", positive: true, deadzone: 0.1)]),
        (action: "fix_view", bindings: [Key("space")]),
        (action: "test", bindings: [Key("t")]),
        (action: "up_wheel", bindings: [Key("Right")]),
        (action: "down_wheel", bindings: [Key("Left")]),
        (action: "toggle_landing_gear", bindings: [Key("g")]),
        (action: "toggle_fbw_pitch", bindings: [Key("b")]),
        (action: "wheel_brake", bindings: [Key("x")]),
        (action: "toggle_parking_brake", bindings: [Key("p")]),
        (action: "quick_menu_up", bindings: [ControllerButton("DPadUp")]),
        (action: "quick_menu_right", bindings: [ControllerButton("DPadRight")]),
        (action: "quick_menu_down", bindings: [ControllerButton("DPadDown")]),
        (action: "quick_menu_left", bindings: [ControllerButton("DPadLeft")]),
        (action: "landing_gear_up", bindings: []),
        (action: "landing_gear_down", bindings: []),
        // F1-F4: what the camera follows.
        (action: "camera_player", bindings: [Key("F1")]),
        (action: "camera_next_aircraft", bindings: [Key("F2")]),
        (action: "camera_next_ground_unit", bindings: [Key("F3")]),
        (action: "camera_next_missile", bindings: [Key("F4")]),
        // F5-F8: debugging and editing the map (F8 free for now).
        // F10: the tactical map.
        (action: "toggle_debug", bindings: [Key("F5")]),
        (action: "toggle_flight_editor", bindings: [Key("F6")]),
        (action: "toggle_debug_mouse", bindings: [Key("F7")]),
        (action: "toggle_tactical_map", bindings: [Key("F10")]),
        // The sandbox camera's orbit toggle - no key.
        (action: "follow_cam_toggle", bindings: []),
        (action: "toggle_pause_menu", bindings: [Key("Escape")]),
        (action: "debug_cam_forward", bindings: [Key("w")]),
        (action: "debug_cam_back", bindings: [Key("s")]),
        (action: "debug_cam_left", bindings: [Key("a")]),
        (action: "debug_cam_right", bindings: [Key("d")]),
        (action: "debug_cam_up", bindings: [Key("space")]),
        (action: "debug_cam_down", bindings: [Key("Left Ctrl")]),
        (action: "debug_cam_sprint", bindings: [Key("Left Shift")]),
        (action: "trim_pitch_up", bindings: [Key("i")]),
        (action: "trim_pitch_down", bindings: [Key("k")]),
        (action: "trim_roll_left", bindings: [Key("j")]),
        (action: "trim_roll_right", bindings: [Key("l")]),
        (action: "trim_yaw_left", bindings: [Key("u")]),
        (action: "trim_yaw_right", bindings: [Key("o")]),
        (action: "ui_left", bindings: [Key("Left")]),
        (action: "ui_right", bindings: [Key("Right")]),
        (action: "ui_click", bindings: [MouseButton("left")]),
    ],
    mouse: (
        x_sensitivity: 0.5,
        y_sensitivity: 0.5,
    ),
)
